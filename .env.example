# Local-only PostgreSQL configuration. Do not use these values in production.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/home247?schema=public"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="home247"
# Generate a local value with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep this blank in the example and never commit a generated value.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
APP_ORIGIN="http://localhost:3000"
TRUST_PROXY_HEADERS="false"
# Set TRUSTED_PROXY_PROVIDER=cloudfront only with the reviewed CloudFront/WAF
# ingress contract. Do not trust Render's X-Forwarded-For header.
RATE_LIMIT_BACKEND="memory"
AUTH_SECURE_COOKIES="false"

# Password reset delivery uses a durable PostgreSQL outbox. Local development
# writes delivery messages to .local-outbox only when the worker command runs.
PASSWORD_RESET_MAILER="local"
# Production worker configuration. Keep these blank in source control.
# PASSWORD_RESET_MAILER="resend"
RESEND_API_KEY=""
PASSWORD_RESET_FROM=""

# Render staging is not production. It may use the in-memory limiter only when
# the service is intentionally restricted to one instance. Render sets RENDER=true.
# DEPLOYMENT_ENV="staging"
# RENDER_STAGING_SINGLE_INSTANCE="true"
# TRUST_PROXY_HEADERS="false"
# RATE_LIMIT_BACKEND="memory"
# AUTH_SECURE_COOKIES="true"

# VNPay stays unavailable to public checkout until sandbox qualification and
# Finance/Security/Operations approval are recorded. Keep this false by default.
VNPAY_PUBLIC_ENABLED="false"
# Credentials are issued per merchant. Keep them blank until a sandbox merchant
# is available. The server also rejects direct session-create requests while the
# public feature gate is false.
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_PAYMENT_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_QUERY_URL="https://sandbox.vnpayment.vn/merchant_webapi/api/transaction"
VNPAY_RETURN_URL="http://localhost:3000/api/v1/payment/return"
VNPAY_ENVIRONMENT="staging"

# Evidence storage. Local is development/test only and is rejected when
# NODE_ENV=production. Staging must use the S3-compatible provider.
EVIDENCE_STORAGE_PROVIDER="local"
# Catalog images use the same private S3-compatible storage contract in
# production. Static demo assets remain under public/assets and do not require
# this provider. A separate catalog bucket can be selected with the optional
# CATALOG_IMAGE_STORAGE_BUCKET; otherwise STORAGE_BUCKET is used with the
# catalog-images/ prefix.
CATALOG_IMAGE_STORAGE_PROVIDER="local"
# CATALOG_IMAGE_STORAGE_BUCKET=""
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_FORCE_PATH_STYLE="false"
